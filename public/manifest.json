{
  "manifest_version": 3,
  "name": "Folio",
  "version": "1.0.0",
  "description": "A premium customizable new tab dashboard with organized bookmarks, quick notes, and beautiful wallpapers.",
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "bookmarks",
    "activeTab",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Add to Folio"
  },
  "host_permissions": [
    "https://fra.cloud.appwrite.io/*"
  ],
  "externally_connectable": {
    "matches": [
      "*://localhost/*",
      "https://folio-webapp.vercel.app/*",
      "https://www.getfolio.tech/*",
      "https://getfolio.tech/*"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open Folio to add a bookmark"
    }
  }
}
